{
  "outputDirectory": "publico",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/probe",
      "destination": "/api/probe"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/docs(.*)",
      "destination": "/api/index"
    }
  ]
}